{
  "namingMode": "prometheus_receiver",
  "localTSDBRetention": "30d",
  "metadata": {
    "http_requests_total": {"type": "counter", "help": "Total HTTP requests"},
    "payments_http_duration_seconds": {"type": "histogram", "help": "Payments HTTP request latency"},
    "checkout_errors_total": {"type": "counter", "help": "Checkout errors"},
    "billing_invoices_total": {"type": "counter", "help": "Billing invoices generated"},
    "orders_live_latency_seconds": {"type": "histogram", "help": "Active orders latency"},
    "orders:live_latency:rate5m": {"type": "gauge", "help": "Recorded orders latency rate"},
    "api_native_latency_seconds": {"type": "histogram", "help": "Native histogram API latency"},
    "weekly_reconciliation_duration_seconds": {"type": "gauge", "help": "Newly deployed weekly cron metric"},
    "inventory_sync_duration_seconds": {"type": "histogram", "help": "Inventory sync duration (only _count queried)"},
    "checkout_legacy_cart_gauge": {"type": "gauge", "help": "Deprecated v1 cart gauge"},
    "search_v1_index_docs_gauge": {"type": "gauge", "help": "Deprecated v1 search index size"},
    "recommendations_ab_experiment": {"type": "histogram", "help": "Finished A/B experiment histogram"},
    "shipping_v1_quote_total": {"type": "counter", "help": "Deprecated v1 shipping quotes"},
    "orders_deprecated_latency_seconds": {"type": "histogram", "help": "Legacy orders latency fed only into dead recording rules"},
    "orders:deprecated_latency:rate5m": {"type": "gauge", "help": "Dead recording rule intermediate"},
    "orders:deprecated_latency:p99": {"type": "gauge", "help": "Dead recording rule leaf"},
    "catalog_v1_cache_entries": {"type": "gauge", "help": "Deprecated v1 catalog cache entries"},
    "promo_legacy_banner_views_total": {"type": "counter", "help": "Deprecated promo banner counter"},
    "up": {"type": "gauge", "help": "Target scrape health"},
    "ALERTS": {"type": "gauge", "help": "Active Prometheus alerts"},
    "ALERTS_FOR_STATE": {"type": "gauge", "help": "Alert pending timestamps"},
    "scrape_duration_seconds": {"type": "gauge", "help": "Scrape duration"},
    "prometheus_tsdb_head_series": {"type": "gauge", "help": "Prometheus TSDB active head series"},
    "alloy_component_controller_running_components": {"type": "gauge", "help": "Grafana Alloy running components"},
    "otelcol_process_uptime": {"type": "counter", "help": "OpenTelemetry Collector uptime"}
  },
