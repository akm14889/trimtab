# Human-owned Prometheus remote_write configuration (wired ONCE).
# Trimtab never edits your prometheus.yml or Prometheus CRD; it manages only the
# synthesized write_relabel_configs overlay (./out/trimtab-remote-write.yaml).
#
# Option 1: Standalone prometheus.yml
# Insert the rules generated by `trimtab synth --target promrw --out ./out/trimtab-remote-write.yaml`
# under remote_write[].write_relabel_configs (via your config template / GitOps overlay):

remote_write:
  - name: prod-mimir
    url: https://mimir.example.com/api/v1/push
    write_relabel_configs:
      # Contents of ./out/trimtab-remote-write.yaml (`write_relabel_configs` list):
      - source_labels:
          - __name__
        regex: "checkout_legacy_cart_gauge|orders_deprecated_latency_seconds_(bucket|sum|count|created)"
        action: drop

# Option 2: Prometheus Operator (`synthesizer.promRW.mode: prometheus_operator_patch`)
# Apply ./out/trimtab-prometheus-operator-patch.yaml via Kustomize strategic-merge patch
# (`patches:` in kustomization.yaml) targeting your `Prometheus` or `PrometheusAgent` CR.
