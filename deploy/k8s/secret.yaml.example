# Example Kubernetes Secret referenced by CronJob envFrom.secretRef.
# Never commit real tokens to Git; provision via External Secrets / Sealed Secrets / Vault.
apiVersion: v1
kind: Secret
metadata:
  name: trimtab-credentials
  labels:
    app.kubernetes.io/name: trimtab
type: Opaque
stringData:
  TRIMTAB_PROM_TOKEN: "replace-with-readonly-metrics-token"
  TRIMTAB_LOKI_API_KEY: "replace-with-readonly-loki-key"
  TRIMTAB_GRAFANA_TOKEN: "replace-with-readonly-grafana-viewer-token"
