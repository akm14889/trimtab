{
  "dashboard": {
    "uid": "e2e-overview",
    "title": "E2E Trimtab Overview",
    "description": "Consolidated Trimtab E2E dashboard across all active/protected metric patterns",
    "tags": ["e2e", "service", "trimtab"],
    "editable": true,
    "schemaVersion": 39,
    "version": 1,
    "refresh": "15s",
    "time": { "from": "now-30m", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Total Used Request Rate",
        "type": "stat",
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(e2e_used_requests_total[5m]))"
          }
        ]
      },
      {
        "id": 2,
        "title": "Full Histogram p95 Latency",
        "type": "stat",
        "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 }, "overrides": [] },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum by (le) (rate(e2e_hist_full_seconds_bucket[5m])))"
          }
        ]
      },
      {
        "id": 3,
        "title": "Avg Latency (_sum / _count only)",
        "type": "stat",
        "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "fieldConfig": { "defaults": { "unit": "s", "decimals": 4 }, "overrides": [] },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(e2e_latency_seconds_sum[5m])) / sum(rate(e2e_latency_seconds_count[5m]))"
          }
        ]
      },
      {
        "id": 4,
        "title": "Live Recording Rule Rate",
        "type": "stat",
        "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 }, "overrides": [] },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(e2e:rr_live:rate5m)"
          }
        ]
      },
      {
        "id": 5,
        "title": "Used Requests Rate by Route & Status",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
        "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (route, status) (rate(e2e_used_requests_total[5m]))",
            "legendFormat": "{{route}} {{status}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "Full Histogram p95 Latency by Route",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
        "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum by (le, route) (rate(e2e_hist_full_seconds_bucket[5m])))",
            "legendFormat": "{{route}}"
          }
        ]
      },
      {
        "id": 7,
        "title": "HTTP Duration — Partial Labels (le, route only)",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
        "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (le, route) (rate(e2e_labels_http_duration_seconds_bucket[5m]))",
            "legendFormat": "{{route}}"
          }
        ]
      },
      {
        "id": 8,
        "title": "Average Latency by Route (_sum / _count only)",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
        "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (route) (rate(e2e_latency_seconds_sum[5m])) / sum by (route) (rate(e2e_latency_seconds_count[5m]))",
            "legendFormat": "{{route}}"
          }
        ]
      },
      {
        "id": 9,
        "title": "Scalar Comparison Label Precision (job used)",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
        "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (job) (rate(e2e_scalar_cmp_total[5m]) > 0)",
            "legendFormat": "{{job}}"
          }
        ]
      },
      {
        "id": 10,
        "title": "Live Recording Rule Rate by Service",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
        "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (service) (e2e:rr_live:rate5m)",
            "legendFormat": "{{service}}"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
