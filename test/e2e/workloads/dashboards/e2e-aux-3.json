{
  "dashboard": {
    "uid": "e2e-aux-3",
    "title": "E2E Aux Full Latency p95",
    "description": "S10 Baseline Drift HWM fixture dashboard (deleted in step 2 of S10)",
    "tags": ["e2e"],
    "editable": true,
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": { "from": "now-30m", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Full Histogram p95 by Route",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
        "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(e2e_hist_full_seconds_bucket[5m])))", "legendFormat": "{{route}}" }]
      }
    ]
  },
  "overwrite": true
}
