# Pinned versions for Trimtab Local Kind E2E Harness (no `:latest` tags)
KIND_CLUSTER_NAME="trimtab-e2e"
KIND_NODE_IMAGE="kindest/node:v1.30.0@sha256:047357ac0cfea04663786a612ba1eaba9702bef25227a794b52890dd8bcd692e"

# Backend container & Helm chart versions
MIMIR_IMAGE="grafana/mimir:2.17.11"
LOKI_HELM_REPO="https://grafana-community.github.io/helm-charts"
LOKI_CHART_VERSION="21.6.0"
GRAFANA_HELM_REPO="https://grafana.github.io/helm-charts"
GRAFANA_CHART_VERSION="10.5.15"
ALLOY_HELM_REPO="https://grafana.github.io/helm-charts"
ALLOY_CHART_VERSION="1.16.0"
CURL_IMAGE="curlimages/curl:8.11.1"
PUSHGATEWAY_IMAGE="prom/pushgateway:v1.11.0"

# Locally built E2E images
GO_BUILDER_IMAGE="golang:1.27-alpine"
ALPINE_IMAGE="alpine:3.21"
TRIMTAB_IMAGE_REPO="${TRIMTAB_IMAGE_REPO:-trimtab}"
TRIMTAB_IMAGE_TAG="${TRIMTAB_IMAGE_TAG:-e2e}"
TRIMTAB_IMAGE="${TRIMTAB_IMAGE:-${TRIMTAB_IMAGE_REPO}:${TRIMTAB_IMAGE_TAG}}"
NOISY_APP_IMAGE="trimtab-e2e-noisy-app:e2e"
TRAFFIC_GEN_IMAGE="trimtab-e2e-traffic-gen:e2e"

# Shared Kubernetes namespaces & tenant
MONITORING_NAMESPACE="monitoring"
TRIMTAB_NAMESPACE="trimtab"
E2E_TENANT_ID="e2e"
